		{"id":"9e207e3092d79ea0","type":"text","text":"Économie monétaire","x":692,"y":1239,"width":150,"height":120,"color":"4"},
		{"id":"8459d07cffd1ab17","type":"text","text":"## Économie","x":1071,"y":869,"width":180,"height":50,"color":"4"},
		{"id":"1bd026e568c1f81a","type":"text","text":"Politique économique","x":945,"y":1359,"width":150,"height":90,"color":"4"},
		{"id":"7fab009f95bec446","type":"text","text":"Macroéconomie","x":805,"y":984,"width":140,"height":110,"color":"4"},
