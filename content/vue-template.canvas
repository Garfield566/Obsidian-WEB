		{"id":"8459d07cffd1ab17","type":"text","text":"## Économie","x":1071,"y":869,"width":180,"height":50,"color":"6"},
		{"id":"1bd026e568c1f81a","type":"text","text":"Politique économique","x":945,"y":1359,"width":150,"height":90},
		{"id":"7fab009f95bec446","type":"text","text":"Macroéconomie","x":805,"y":984,"width":140,"height":110},
		{"id":"57320769295e9f3c","type":"text","text":"Économétrie","x":1121,"y":1219,"width":120,"height":40},
		{"id":"d3486a390828e745","type":"text","text":"Économie comportementale","x":1171,"y":1119,"width":180,"height":40},
		{"id":"aab9b4d243a04832","type":"text","text":"Économie financière","x":1271,"y":984,"width":189,"height":75},
		{"id":"345831711bda73a2","type":"text","text":"Microéconomie","x":1071,"y":984,"width":140,"height":75},
