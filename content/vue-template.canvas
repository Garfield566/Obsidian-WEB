		{"id":"fc46c4ac94ca4009","type":"text","text":"### notion_math","x":-905,"y":-189,"width":250,"height":60,"color":"4"},
		{"id":"7a8ceea79196b4bb","type":"text","text":"### conjecture","x":-640,"y":-254,"width":250,"height":60,"color":"4"},
		{"id":"ff83d75a325c3287","type":"text","text":"## Jeux de Stratégie","x":-204,"y":-360,"width":460,"height":98,"color":"4"},
		{"id":"fbcc221e6c4f4b00","type":"text","text":"## Livre","x":-2029,"y":-376,"width":283,"height":100,"color":"4"},
		{"id":"965642ae61b14699","type":"text","text":"### theoreme","x":-1097,"y":-284,"width":250,"height":60,"color":"4"},
		{"id":"c5f8f060c728981a","type":"text","text":"## Mathématiques","x":-950,"y":-484,"width":383,"height":129,"color":"4"},
