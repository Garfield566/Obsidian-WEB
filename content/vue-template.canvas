		{"id":"c11462f205b7dfa8","type":"text","text":"### domaine","x":-1593,"y":328,"width":250,"height":60,"color":"3"},
		{"id":"9e207e3092d79ea0","type":"text","text":"Économie monétaire","x":1282,"y":1177,"width":150,"height":120},
