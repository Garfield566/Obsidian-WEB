		{"id":"db7e1026a4030f62","type":"group","x":-2880,"y":-531,"width":1720,"height":1409,"color":"6","label":"T-Généraux"},
		{"id":"9acd9e3771500eb4","type":"text","text":"### recette","x":1432,"y":679,"width":250,"height":60},
		{"id":"4bf9bee0b731cc3a","type":"text","text":"## Cuissine","x":1407,"y":570,"width":250,"height":60,"color":"#ca58c7"},
		{"id":"ec276c5b6765f06f","type":"text","text":"## Concept","x":-1593,"y":198,"width":250,"height":60,"color":"4"},
		{"id":"c11462f205b7dfa8","type":"text","text":"### domaine","x":-1593,"y":328,"width":250,"height":60,"color":"3"},
		{"id":"6704dfcb74d85663","type":"text","text":"## Perssonage","x":-1760,"y":522,"width":240,"height":100,"color":"4"},
