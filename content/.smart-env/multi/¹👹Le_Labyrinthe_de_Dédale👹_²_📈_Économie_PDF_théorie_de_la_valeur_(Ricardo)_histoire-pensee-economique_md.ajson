&selection=14,0,58,11&color=note","line":12},{"title":"histoire-pensee-economique PDF, p.3","target":"histoire-pensee-economique PDF.pdf#page=3&selection=67,0,81,8&color=red","line":22}],"class_name":"SmartBlock","last_embed":{"hash":"hu5jal","at":1771856749278}},
