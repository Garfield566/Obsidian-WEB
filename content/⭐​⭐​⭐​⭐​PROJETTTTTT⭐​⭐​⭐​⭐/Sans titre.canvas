		{"id":"323cef987ff15637","x":248,"y":1961,"width":312,"height":134,"type":"text","text":"Rythme contrôlé\n\nPas de suggestion sans digestion  \nValidation explicite ou implicite  \nC'est l'utilisateur qui contrôle"},
