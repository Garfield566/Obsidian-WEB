bpath": null}, {"type": "text", "id": "0b6e8f55c900466b", "x": -1651, "y": -373, "width": 376, "height": 98, "color": "#a6e3a1", "text": "Cyberpunk Edgerunners et Vinland Saga se situent dans un contexte technologique ou dystopique."}, {"type": "text", "id": "91f524fcbe8c4946", "x": -184, "y": -292, "width": 380, "height": 98, "color": "#b4befe", "text": "JoJo (Golden Wind) et Mononoke integrent une dimension surnaturelle ou mystique dans leur univers."}, {"type": "text", "id": "62406cb8664449cb", "x": 378, "y": -630, "width": 380, "height": 124, "color": "#a6e3a1", "text": "Cyberpunk Edgerunners et JoJo (Golden Wind) questionnent le pouvoir et l'ambition a travers le parcours des personnages."}, {"type": "text", "id": "95d9fcdcfbbe4baa", "x": -486, "y": -657, "width": 380, "height": 124, "color": "#a6e3a1", "text": "Cyberpunk Edgerunners, JoJo (Golden Wind) et Vinland Saga se deroulent dans des univers ou le combat et la violence occupent une place centrale."}, {"type": "text", "id": "43a6a78b598a4158", "x": -486, "y": -224, "width": 380, "height": 124, "color": "#a6e3a1", "text": "Cyberpunk Edgerunners, JoJo (Golden Wind) et Mononoke interrogent l'identite et la transformation profonde des personnages."}], "edges": [{"id": "2eb5d2a5e9a44e94", "fromNode": "ab7a38fed7664f72", "fromSide": "right", "fromEnd": null, "toNode": "54951376454f4325", "toSide": "left", "toEnd": null, "color": "#f5c2e7", "label": "tag"}, {"id": "c19baf8976184cfe", "fromNode": "54951376454f4325", "fromSide": "right", "fromEnd": null, "toNode": "e6195ac962284c41", "toSide": "left", "toEnd": null, "color": "#cba6f7", "label": null}, {"id": "982693f807cf4171", "fromNode": "54951376454f4325", "fromSide": "right", "fromEnd": null, "toNode": "eb0191cc7bdb4d01", "toSide": "left", "toEnd": null, "color": "#cba6f7", "label": null}, {"id": "42117ad02b344122", "fromNode": "54951376454f4325", "fromSide": "bottom", "fromEnd": null, "toNode": "1638ad78cffa4ea4", "toSide": "top", "toEnd": null, "color": "#cb