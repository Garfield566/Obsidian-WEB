		{"id":"p4_prix_grp","type":"group","x":-860,"y":13100,"width":2620,"height":1800,"color":"5","label":"Selon la Réaction au Prix"},
		{"id":"p3_tax_grp","type":"group","x":40,"y":2300,"width":2700,"height":1600,"color":"4","label":"Taxes et Subventions"},
