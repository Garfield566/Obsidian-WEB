		{"id":"c515588f1ccc27f9","fromNode":"p3_grp","fromSide":"bottom","toNode":"p2_sur","toSide":"top","color":"4","label":"Taxes et contrôles créent une perte sèche"},
		{"id":"0ffd94a88ba86132","fromNode":"p4_grp","fromSide":"top","toNode":"p1_grp","toSide":"bottom","color":"1","label":"Demande individuelle → demande de marché"},
		{"id":"84fd0f3df7d7ea56","fromNode":"p4_grp","fromSide":"right","toNode":"p2_grp","toSide":"left","color":"2","label":"Élasticités issues des choix du consommateur"},
		{"id":"b5eac52ab0c14baf","fromNode":"p4_grp","fromSide":"bottom","toNode":"slut_grp","toSide":"top","color":"3","label":"Slutsky décompose l'effet d'un changement de prix"},
		{"id":"3ca202122eabfe36","fromNode":"slut_grp","fromSide":"right","toNode":"p4_tb","toSide":"left","color":"3","label":"ES/ER détermine le type de bien (normal, inférieur, Giffen)"},
		{"id":"52408a15867036d0","fromNode":"p5_grp","fromSide":"top","toNode":"p1_grp","toSide":"bottom","color":"1","label":"La fonction d'offre découle du comportement du producteur"},
		{"id":"8b321ca3f4a83512","fromNode":"p5_grp","fromSide":"right","toNode":"p6_grp","toSide":"left","color":"1","label":"P = Cm : condition d'optimum du producteur en CPP"},
		{"id":"a4ff8f28341fb051","fromNode":"p5_grp","fromSide":"right","toNode":"p7_grp","toSide":"left","color":"5","label":"Rm = Cm : même logique de maximisation du profit"},
		{"id":"29eca3cd8024eaf8","fromNode":"p6_grp","fromSide":"right","toNode":"p7_grp","toSide":"left","color":"5","label":"Monopole : rupture avec la CPP (pouvoir de marché)"},
