		{"id":"4cd1aa60ca156c26","fromNode":"p1_grp","fromSide":"right","toNode":"p2_grp","toSide":"left","color":"2","label":"L'élasticité mesure la sensibilité de l'offre et de la demande"},
		{"id":"0013f76e9748ef94","fromNode":"p2_grp","fromSide":"right","toNode":"p3_grp","toSide":"left","color":"4","label":"L'incidence fiscale dépend des élasticités"},
