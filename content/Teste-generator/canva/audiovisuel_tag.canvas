: null}, {"type": "text", "id": "0477e79706424156", "x": 378, "y": -630, "width": 380, "height": 124, "color": "6", "text": "Cyberpunk Edgerunners et JoJo (Golden Wind) questionnent le pouvoir et l'ambition a travers le parcours des personnages."}, {"type": "text", "id": "2b8750527a7c45ff", "x": -1633, "y": -373, "width": 340, "height": 98, "color": "6", "text": "Cyberpunk Edgerunners et Vinland Saga placent la survie au coeur de l'enjeu narratif."}, {"type": "text", "id": "e074f048f2fe46c7", "x": -184, "y": -292, "width": 380, "height": 98, "color": "6", "text": "JoJo (Golden Wind) et Mononoke integrent une dimension surnaturelle ou mystique dans leur univers."}, {"type": "text", "id": "7d1caac52558482b", "x": -486, "y": -224, "width": 380, "height": 124, "color": "6", "text": "Cyberpunk Edgerunners, JoJo (Golden Wind) et Mononoke interrogent l'identite et la transformation profonde des personnages."}, {"type": "text", "id": "07089f07078e4201", "x": -486, "y": -657, "width": 380, "height": 124, "color": "6", "text": "Cyberpunk Edgerunners, JoJo (Golden Wind) et Vinland Saga se deroulent dans des univers ou le combat et la violence occupent une place centrale."}], "edges": [{"id": "c459eeb9eb814231", "fromNode": "c2257964fdaf4528", "fromSide": "right", "fromEnd": null, "toNode": "f3dd1fa1069a4ef5", "toSide": "left", "toEnd": null, "color": "1", "label": "tag"}, {"id": "2bff3c26b11640a4", "fromNode": "f3dd1fa1069a4ef5", "fromSide": "right", "fromEnd": null, "toNode": "a9489c4a5d5b444f", "toSide": "left", "toEnd": null, "color": "#cba6f7", "label": null}, {"id": "bc2b4702ccbc4c4e", "fromNode": "f3dd1fa1069a4ef5", "fromSide": "right", "fromEnd": null, "toNode": "a20e68487ba846aa", "toSide": "left", "toEnd": null, "color": "#cba6f7", "label": null}, {"id": "bdc0f7f1547f4f28", "fromNode": "f3dd1fa1069a4ef5", "fromSide": "bottom", "fromEnd": null, "toNode": "60ecfb1043344cff", "toSide": "top", "toEnd": null, "color": "#cba6f7", "label": null}, {"id": "3b785a94700e4f4c", "