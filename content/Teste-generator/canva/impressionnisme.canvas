toNode": "0fda367bf5c8437a", "toSide": "right", "toEnd": null, "color": "#f5c2e7", "label": "est un type de"}, {"id": "e48402120b294ca7", "fromNode": "a47c0fa633ec44d7", "fromSide": "top", "fromEnd": null, "toNode": "f747ee33dff743a3", "toSide": "bottom", "toEnd": null, "color": "#f5c2e7", "label": "est un type de"}, {"id": "fc1189f3b8e9423e", "fromNode": "a47c0fa633ec44d7", "fromSide": "top", "fromEnd": null, "toNode": "faf6a8c7d938478c", "toSide": "bottom", "toEnd": null, "color": "#f5c2e7", "label": "est un type de"}, {"id": "d5eb1f68a84c47ec", "fromNode": "a47c0fa633ec44d7", "fromSide": "top", "fromEnd": null, "toNode": "556d60ef406f4881", "toSide": "bottom", "toEnd": null, "color": "#f5c2e7", "label": "est un type de"}, {"id": "544a10a81bc84663", "fromNode": "a47c0fa633ec44d7", "fromSide": "top", "fromEnd": null, "toNode": "19efc42e90374128", "toSide": "bottom", "toEnd": null, "color": "#f5c2e7", "label": "fait partie de"}, {"id": "5e279dd7a6d74d59", "fromNode": "a47c0fa633ec44d7", "fromSide": "top", "fromEnd": null, "toNode": "d13f5957c084460b", "toSide": "bottom", "toEnd": null, "color": "#f5c2e7", "label": "fait partie de"}, {"id": "a21b1074ceda4694", "fromNode": "a47c0fa633ec44d7", "fromSide": "right", "fromEnd": null, "toNode": "511868f8b4ae41a5", "toSide": "left", "toEnd": null, "color": "#f5c2e7", "label": "sujet de"}, {"id": "cfae64ebf6d847f3", "fromNode": "a47c0fa633ec44d7", "fromSide": "right", "fromEnd": null, "toNode": "cb65f57832f14e23", "toSide": "left", "toEnd": null, "color": "#f5c2e7", "label": "sujet de"}]}