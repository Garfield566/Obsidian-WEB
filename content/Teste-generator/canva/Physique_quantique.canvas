abel": "li\u00e9 \u00e0"}, {"id": "957dccb2d67a4a9d", "fromNode": "58813ae7fee94830", "fromSide": "top", "fromEnd": null, "toNode": "f6cec161825d47fc", "toSide": "bottom", "toEnd": null, "color": null, "label": "li\u00e9 \u00e0"}]}