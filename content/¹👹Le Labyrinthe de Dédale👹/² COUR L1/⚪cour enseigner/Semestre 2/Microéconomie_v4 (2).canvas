		{"id":"p6_grp","type":"group","x":-4320,"y":4850,"width":2080,"height":1110,"color":"1","label":"Partie 6 — Concurrence Pure et Parfaite (CPP)"},
		{"id":"p3_grp","type":"group","x":40,"y":320,"width":2080,"height":1010,"color":"4","label":"Partie 3 — Intervention Publique"},
